# Telegram application credentials from https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Existing Telethon session path, or a new local session name.
# Never commit the resulting .session file.
TELEGRAM_SESSION=mentor_agent

# Comma-separated channel usernames or numeric IDs. Numeric IDs are preferred.
# Example: -1001234567890,-1009876543210
MENTOR_CHANNELS=

# Collector storage. Both paths are ignored by git.
MENTOR_DB_PATH=mentor_data/messages.sqlite3
MENTOR_MEDIA_DIR=mentor_data/media

# OpenAI vision analysis (API billing is separate from ChatGPT)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol
OPENAI_REASONING_EFFORT=medium
