[Unit]
Description=Mentor post AI analyzer
After=network-online.target mentor-collector.service
Wants=network-online.target

[Service]
Type=simple
User=ict
WorkingDirectory=/home/ict/btc-ict-bot
ExecStart=/home/ict/btc-ict-bot/.venv/bin/python run_mentor_worker.py --env-file .env.mentor --notify-env-file .env.daily_on
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
