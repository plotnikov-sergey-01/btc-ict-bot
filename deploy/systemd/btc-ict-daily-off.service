[Unit]
Description=btc-ict-bot demo daily OFF
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ict
WorkingDirectory=/home/ict/btc-ict-bot
EnvironmentFile=/home/ict/btc-ict-bot/.env.daily_off
ExecStart=/home/ict/btc-ict-bot/.venv/bin/python run_live.py --config configs/ict_daily_off.yaml --env-file .env.daily_off
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
